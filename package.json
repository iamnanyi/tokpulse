{
  "name": "tokpulse",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/cli.mjs start",
    "doctor": "node src/cli.mjs doctor",
    "test": "node --test test/*.test.mjs",
    "test:browser": "node test/browser.mjs && node test/browser.mjs --zcode",
    "install:auto": "node src/cli.mjs install",
    "stop": "node src/cli.mjs stop",
    "uninstall": "node src/cli.mjs uninstall",
    "start:zcode": "node src/cli.mjs start --app zcode",
    "doctor:zcode": "node src/cli.mjs doctor --app zcode",
    "install:zcode": "node src/cli.mjs install --app zcode",
    "launch:zcode": "node src/cli.mjs launch --app zcode",
    "stop:zcode": "node src/cli.mjs stop --app zcode",
    "uninstall:zcode": "node src/cli.mjs uninstall --app zcode"
  },
  "description": "A lightweight, native-style estimated token speed bar for ChatGPT, Codex and ZCode on macOS.",
  "repository": {
    "type": "git",
    "url": "https://github.com/iamnanyi/tokpulse.git"
  }
}
